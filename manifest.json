{
  "manifest_version": 3,
  "name": "TubeIntent — YouTube Focus & Distraction Blocker",
  "version": "1.0.0",
  "description": "Reclaim your focus. TubeIntent replaces YouTube's home feed with a zen search bar, blocks Shorts, and hides distracting recommendations and comments.",
  "author": "TubeIntent",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "webNavigation"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TubeIntent Settings"
  }
}
